# Copy to .env on the server. Keep .env private and never commit it.

# Django
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=your-domain.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000

# PostgreSQL installed directly on the Ubuntu host (not inside this Compose stack).
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=financejnj
POSTGRES_USER=financeuser
POSTGRES_PASSWORD=REPLACE_WITH_THE_DATABASE_USER_PASSWORD
POSTGRES_BACKUP_HOST=127.0.0.1

# Caddy TLS contact email; update Caddyfile to match your domain and email.
