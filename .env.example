# Telur Finance - Production Environment Variables
# Copy to .env and fill in values
# DO NOT COMMIT .env TO VERSION CONTROL

# Django Core
SECRET_KEY=your-secret-key-here-min-50-chars
DEBUG=0
ALLOWED_HOSTS=telur-finance.example.com,www.telur-finance.example.com

# Database (PostgreSQL 16)
POSTGRES_DB=telur_finance
POSTGRES_USER=telur
POSTGRES_PASSWORD=strong-random-password
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Email (configure for production)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=email-password
DEFAULT_FROM_EMAIL=noreply@telur-finance.example.com

# Caddy (auto HTTPS)
# Caddyfile uses tls admin@example.com - change to your email
# No additional env vars needed for Caddy

# Optional: Redis for caching (if available)
# REDIS_URL=redis://redis:6379/0

# Monitoring (optional)
# SENTRY_DSN=https://xxx@sentry.io/xxx