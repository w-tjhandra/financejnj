# Salin ke .env lalu sesuaikan. JANGAN commit .env.
# Semua nilai di bawah hanya contoh untuk pengembangan lokal.

# --- Django ---
# Default manage.py = config.settings.dev; pytest = config.settings.test.
# Set baris berikut hanya untuk produksi:
# DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=dev-only-ganti-di-produksi
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=telur_finance
POSTGRES_USER=telur
POSTGRES_PASSWORD=telur_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Alternatif: satu URL (menimpa POSTGRES_* di atas)
# DATABASE_URL=postgresql://telur:telur_dev@db:5432/telur_finance

# --- Opsional ---
APP_PORT=8000
DJANGO_LOG_LEVEL=INFO

# --- Produksi (hanya dipakai saat DJANGO_SETTINGS_MODULE=config.settings.prod) ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://contoh.domain
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
